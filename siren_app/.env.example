# SIREN · contoh pengaturan
#
# SIREN tetap berjalan tanpa file .env: semua nilai di bawah ini adalah
# bawaan aplikasi (app/config.py). Untuk mengubahnya, salin file ini menjadi
# .env di folder yang sama, lalu ubah baris yang perlu saja:
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# Setelah mengubah .env, restart server SIREN.

# --- Umum --------------------------------------------------------------------
# Nama unit ambulans; tampil di topbar, PDF, dan label
AMBULANCE_ID=SIREN-01
# Lokasi database. Path relatif dihitung dari folder siren_app.
DATABASE_URL=sqlite:///./siren.db

# --- Sensor ESP32 --------------------------------------------------------------
# Kosongkan agar semua port USB dibuka dan setiap board dikenali dari datanya.
# Isi hanya untuk mengunci port, dipisah koma, mis. /dev/ttyUSB0,/dev/ttyACM0
SERIAL_PORTS=
SERIAL_BAUD=115200

# Mode awal saat pertama kali dijalankan. Setelah mode diganti di menu
# Perangkat, pilihan itu disimpan di runtime.json dan dipakai seterusnya.
# true = simulasi (angka buatan, berlabel SIMULASI), false = sensor sungguhan
MOCK_SENSORS=false
# Skenario simulasi: stable | deteriorating (pasien memburuk dalam 5 menit)
MOCK_SCENARIO=stable

# --- Printer label (thermal 58 mm, ESC/POS) -------------------------------------
# none   = printer belum diatur
# file   = label disimpan sebagai PNG di PRINTER_DEVICE (folder), tanpa printer
# escpos = cetak ke PRINTER_DEVICE:
#          /dev/usb/lp0             printer USB
#          /dev/serial/by-id/...    printer USB-serial (nama stabil)
#          /dev/rfcomm0             printer Bluetooth (lihat README_DEPLOY.md B4)
#          COM5                     di Windows
PRINTER_BACKEND=none
PRINTER_DEVICE=
PRINTER_BAUD=9600
# Lebar cetak dalam titik: 384 = printer 58 mm pada 203 dpi
PRINTER_WIDTH_PX=384

# --- Lanjutan: ubah hanya bila tahu dampaknya --------------------------------------
# Nilai sensor lebih tua dari ini (detik) dianggap tidak ada
# SENSOR_STALE_S=5
# Lama nilai vital manual berlaku (detik)
# MANUAL_TTL_S=900
# Jarak antar snapshot ke database selama pemantauan (detik)
# SNAPSHOT_INTERVAL_S=10
# Getaran (g RMS) di atas ini menandai nadi dan laju napas "getaran tinggi"
# MOTION_FLAG_G=0.15
# Batas usia untuk aturan work-up (lansia >= 60, anak < 18)
# ELDERLY_AGE=60
# PAEDIATRIC_AGE=18
# Lokasi model estimasi tekanan darah, bila tidak di siren_app/models/
# BP_MODEL_PATH=
# BP_METRICS_PATH=
